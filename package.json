{
  "name": "levigno",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import tsx --test tests/e2e/*.test.ts",
    "test:e2e": "npx tsx tests/e2e/run-all.ts",
    "assets:upload-amenities": "node scripts/upload-amenities.mjs",
    "build:worker": "opennextjs-cloudflare build && cp .open-next/worker.js .open-next/assets/_worker.js && cp -r .open-next/cloudflare .open-next/assets/cloudflare && cp -r .open-next/middleware .open-next/assets/middleware && cp -r .open-next/server-functions .open-next/assets/server-functions && cp -r .open-next/.build .open-next/assets/.build && node scripts/prepare-pages-assets.mjs && node patch-worker.mjs",
    "pages:build": "npm run build:worker",
    "assets:upload-floor-plans": "node scripts/upload-floor-plans.mjs",
    "assets:upload-typologies": "node scripts/upload-typologies.mjs",
    "deploy": "npm run pages:build && wrangler pages deploy .open-next/assets --project-name levigno"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.8",
    "bcryptjs": "^3.0.3",
    "daisyui": "^5.7.50",
    "drizzle-orm": "^0.45.4",
    "gsap": "^3.14.2",
    "html-to-image": "^1.11.13",
    "konva": "^10.9.0",
    "lucide-react": "^0.563.0",
    "mapbox-gl": "^3.18.1",
    "next": "16.1.6",
    "next-auth": "^5.0.0-beta.31",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-konva": "^19.3.2",
    "react-map-gl": "^8.1.0",
    "resend": "^6.12.3",
    "use-image": "^1.1.4",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.18.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wrangler": "^4.151.3"
  },
  "type": "module"
}
